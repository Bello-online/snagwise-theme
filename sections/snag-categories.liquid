{{ 'snag.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Cats-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

<div id="Cats-{{ section.id }}" class="snag-cats color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="snag-head">
      <h2 class="snag-head__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="snag-head__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <ul class="snag-tiles snag-tiles--{{ section.settings.columns_desktop }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign label = block.settings.label
          if label == blank
            assign label = collection.title
          endif
          assign image = block.settings.image
          if image == blank
            assign image = collection.image
          endif
          if image == blank
            assign image = collection.products.first.featured_image
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ collection.url | default: '#' }}" class="snag-tile">
            <span class="snag-tile__media">
              {%- if image != blank -%}
                {{ image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
              {%- endif -%}
            </span>
            <span class="snag-tile__bar">
              <span>{{ label | escape }}</span>
              {%- if collection != blank -%}
                <span class="snag-tile__count">{{ collection.products_count }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "SnagWise categories",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave empty to use the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the collection image, then its first product." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SnagWise categories",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
