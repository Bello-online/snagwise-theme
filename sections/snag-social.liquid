{{ 'snag.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Social-{{ section.id }} { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

<div id="Social-{{ section.id }}" class="snag-social color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="snag-head">
      <h2 class="snag-head__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="snag-head__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="snag-social__grid">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: section.settings.instagram_url | default: '#' }}" class="snag-social__item" {% if block.settings.link != blank or section.settings.instagram_url != blank %}target="_blank" rel="noopener"{% endif %}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 16vw, 33vw', alt: block.settings.image.alt | default: '' }}
              {%- else -%}
                {%- liquid
                  assign fallback = section.settings.fallback_collection
                  assign idx = forloop.index0 | modulo: fallback.products.size
                  assign fallback_image = fallback.products[idx].featured_image
                -%}
                {%- if fallback_image != blank -%}
                  {{ fallback_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 16vw, 33vw', alt: '' }}
                {%- endif -%}
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.instagram_url != blank or section.settings.tiktok_url != blank -%}
      <ul class="snag-social__handles">
        {%- if section.settings.instagram_url != blank -%}
          <li><a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">{{ section.settings.instagram_label | default: 'Instagram' | escape }}</a></li>
        {%- endif -%}
        {%- if section.settings.tiktok_url != blank -%}
          <li><a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">{{ section.settings.tiktok_label | default: 'TikTok' | escape }}</a></li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SnagWise social feed",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Drops land on the feed first"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Unboxings, stock counts and the Thursday drop preview."
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Posts without an image show products from this collection until you add real posts."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Instagram label",
      "default": "@snagwise on Instagram"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "tiktok_label",
      "label": "TikTok label",
      "default": "@snagwise on TikTok"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to the Instagram URL." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SnagWise social feed",
      "blocks": [
        { "type": "post" }, { "type": "post" }, { "type": "post" },
        { "type": "post" }, { "type": "post" }, { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
